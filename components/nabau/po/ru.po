msgstr "Загрузка"

#: src/ui/pages/review_page.cpp src/ui/pages/software_page.cpp
msgid "nothing"
msgstr "ничего"

#: src/ui/pages/review_page.cpp
msgid "The disk layout cannot be installed"
msgstr "Разметку диска нельзя установить"

#: src/ui/pages/review_page.cpp
#, python-brace-format
msgid "{disk} will be erased"
msgstr "{disk} будет стёрт"

#: src/ui/pages/review_page.cpp
#, python-brace-format
msgid "All {size} on this device is reformatted. Other disks are left untouched."
msgstr "Все {size} на этом устройстве будут переформатированы. Другие диски останутся нетронутыми."

#: src/ui/pages/review_page.cpp
msgid "Partitions will be deleted"
msgstr "Разделы будут удалены"

#: src/ui/pages/review_page.cpp
msgid "What the custom layout deletes is lost once the installation starts. Edit the storage to check the pending changes."
msgstr "То, что удаляет пользовательская разметка, будет потеряно после начала установки. Откройте хранилище, чтобы проверить ожидающие изменения."

#: src/ui/pages/review_page.cpp
msgid "Your existing data is kept"
msgstr "Ваши данные сохранятся"

#: src/ui/pages/review_page.cpp
msgid "Only the space chosen on the destination step is changed."
msgstr "Изменяется только пространство, выбранное на шаге назначения."

#: src/ui/pages/software_page.cpp
msgid "BASE ENVIRONMENT"
msgstr "БАЗОВАЯ СРЕДА"

#: src/ui/pages/software_page.cpp
msgid "Choose what to install."
msgstr "Выберите, что установить."

#: src/ui/pages/software_page.cpp
msgid "Start from a base environment, then add only what you need. You can install or remove anything later with dnf."
msgstr "Начните с базовой среды, затем добавьте только то, что вам нужно. Позже можно установить или удалить что угодно с помощью dnf."

#: src/ui/pages/software_page.cpp
msgid "Installing from this live system"
msgstr "Установка из этой live-системы"

#: src/ui/pages/software_page.cpp
msgid "The live system is copied to the disk as it is. The other environments come from the network installation image."
msgstr "Live-система копируется на диск как есть. Остальные среды берутся из сетевого установочного образа."

#: src/ui/pages/software_page.cpp
#, python-brace-format
msgid "ADD-ONS FOR {name}"
msgstr "ДОПОЛНЕНИЯ ДЛЯ {name}"

#: src/ui/pages/software_page.cpp
msgid "Add-ons are downloaded: connect to a network to choose them."
msgstr "Дополнения загружаются: подключитесь к сети, чтобы выбрать их."

#: src/ui/pages/software_page.cpp
msgid "Download size"
msgstr "Размер загрузки"

#: src/ui/pages/software_page.cpp
msgid "Installed size"
msgstr "Размер после установки"

#: src/ui/pages/software_page.cpp
msgid "Est. install time"
msgstr "Прим. время установки"

#: src/ui/pages/software_page.cpp
#, python-brace-format
msgid "~{n} min"
msgstr "~{n} мин"

