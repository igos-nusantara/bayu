#: src/anaconda_backend.cpp
msgid "Starting the installation backend"
msgstr "Запуск серверной части установки"

#: src/anaconda_backend.cpp
msgid "The installer needs administrator rights, which were not given."
msgstr "Для установщика нужны права администратора, которые не были предоставлены."

#: src/anaconda_backend.cpp
msgid "The installation backend stopped unexpectedly. Its log is in /tmp/anaconda.log."
msgstr "Серверная часть установки неожиданно остановилась. Её журнал находится в /tmp/anaconda.log."

#: src/anaconda_backend.cpp
msgid "Cannot start the installation backend (pkexec is missing)."
msgstr "Не удаётся запустить серверную часть установки (отсутствует pkexec)."

#: src/anaconda_backend.cpp
msgid "This partition holds LVM or Btrfs volumes. Delete it to use its space."
msgstr "Этот раздел содержит тома LVM или Btrfs. Удалите его, чтобы использовать его пространство."

#: src/anaconda_backend.cpp
msgid "This partition cannot be resized."
msgstr "Размер этого раздела нельзя изменить."

#: src/anaconda_backend.cpp
msgid "Choose a disk first."
msgstr "Сначала выберите диск."

#: src/anaconda_backend.cpp
msgid "This disk already has a root (/) mount point."
msgstr "На этом диске уже есть точка монтирования корня (/)."

#: src/anaconda_backend.cpp
msgid "There is not enough free space left for the system."
msgstr "Для системы не осталось достаточно свободного места."

#: src/anaconda_backend.cpp
msgid "This live system"
msgstr "Эта live-система"

#: src/anaconda_backend.cpp
msgid "The desktop on this media, as you see it now: Files, Terminal, Settings"
msgstr "Рабочий стол на этом носителе в том виде, как вы видите его сейчас: Файлы, Терминал, Параметры"

#: src/anaconda_backend.cpp
msgid "Development Tools"
msgstr "Инструменты разработки"

#: src/anaconda_backend.cpp
msgid "gcc, make, git, headers"
msgstr "gcc, make, git, заголовочные файлы"

#: src/anaconda_backend.cpp
msgid "Container Tools"
msgstr "Инструменты контейнеров"

#: src/anaconda_backend.cpp
msgid "podman, buildah, skopeo"
msgstr "podman, buildah, skopeo"

#: src/anaconda_backend.cpp
msgid "RPM Development"
msgstr "Разработка RPM"

#: src/anaconda_backend.cpp
msgid "rpmbuild, mock"
msgstr "rpmbuild, mock"

#: src/anaconda_backend.cpp
msgid "Headless Management"
msgstr "Управление без монитора"

#: src/anaconda_backend.cpp
msgid "cockpit, remote administration"
msgstr "cockpit, удалённое администрирование"

#: src/anaconda_backend.cpp
msgid "Scientific Support"
msgstr "Научные инструменты"

#: src/anaconda_backend.cpp
msgid "Math and science libraries"
msgstr "Математические и научные библиотеки"

#: src/anaconda_backend.cpp
msgid "Checking the installation medium"
msgstr "Проверка установочного носителя"

#: src/anaconda_backend.cpp
msgid "The installation medium is damaged: part of it cannot be read as it was made. Nothing on the disks has changed. Copy the image to the USB drive again, check its SHA-256, or use another USB drive."
msgstr "Установочный носитель повреждён: часть его нельзя прочитать в исходном виде. На дисках ничего не изменено. Скопируйте образ на USB-накопитель заново, проверьте его SHA-256 или используйте другой накопитель."

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "==> {path} <=="
msgstr "==> {path} <=="

#: src/anaconda_backend.cpp
msgid "(cannot be read)"
msgstr "(не удаётся прочитать)"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "Checking the installation medium · {percent}%"
msgstr "Проверка установочного носителя · {percent}%"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "Cannot connect to the installation backend at {address}."
msgstr "Не удаётся подключиться к серверной части установки по адресу {address}."

#: src/anaconda_backend.cpp
msgid "Reading the disks"
msgstr "Чтение дисков"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "The EFI partition {device} has {free} MB free; the boot loader needs {needed} MB."
msgstr "На разделе EFI {device} свободно {free} МБ; загрузчику нужно {needed} МБ."

#: src/anaconda_backend.cpp
msgid "Lay out the disk first."
msgstr "Сначала разметьте диск."

#: src/anaconda_backend.cpp
msgid "Finishing the installed system"
msgstr "Завершение установки системы"

#: src/anaconda_backend.cpp
msgid "Finishing the system did not complete; see /tmp/nabau-post.log"
msgstr "Завершение установки системы не удалось; см. /tmp/nabau-post.log"

#: src/anaconda_backend.cpp
msgid "Complete"
msgstr "Готово"

#: src/network_manager.cpp
#, python-brace-format
msgid "Wired · {name}"
msgstr "Проводное · {name}"

#: src/network_manager.cpp
#, python-brace-format
msgid "Connected · {rate}"
msgstr "Подключено · {rate}"

#: src/network_manager.cpp
msgid "Connected"
msgstr "Подключено"

#: src/network_manager.cpp
msgid "Cable connected · not set up"
msgstr "Кабель подключён · не настроено"

#: src/network_manager.cpp
msgid "Cable unplugged"
msgstr "Кабель отключён"

#: src/network_manager.cpp
#, python-brace-format
msgid "{security} · secured"
msgstr "{security} · защищённая"

#: src/network_manager.cpp
msgid "Open network"
msgstr "Открытая сеть"

#: src/network_manager.cpp
msgid "Personal hotspot"
msgstr "Личная точка доступа"

#: src/network_manager.cpp
msgid "NetworkManager is not running."
msgstr "NetworkManager не запущен."

#: src/ui/disk_editor.cpp
msgid "unformatted"
msgstr "не отформатировано"

#: src/ui/disk_editor.cpp
msgid "encrypted"
msgstr "зашифровано"

#: src/ui/disk_editor.cpp
msgid "Free space"
msgstr "Свободное место"

#: src/ui/disk_editor.cpp
#, python-brace-format
msgid "From {min} to {max}"
msgstr "От {min} до {max}"

#: src/ui/disk_editor.cpp
msgid "PARTITIONS"
msgstr "РАЗДЕЛЫ"

#: src/ui/disk_editor.cpp
msgid "MOUNT POINTS"
msgstr "ТОЧКИ МОНТИРОВАНИЯ"

#: src/ui/disk_editor.cpp
msgid "PENDING CHANGES"
msgstr "ОЖИДАЮЩИЕ ИЗМЕНЕНИЯ"

#: src/ui/disk_editor.cpp
msgid "Reset all"
msgstr "Сбросить всё"

#: src/ui/disk_editor.cpp
#, python-brace-format
msgid "{size} free"
msgstr "Свободно: {size}"

#: src/ui/disk_editor.cpp
msgid "Select a part of a disk above."
msgstr "Выберите область диска выше."

#: src/ui/disk_editor.cpp
msgid "Too small to hold a mount point."
msgstr "Слишком мало места для точки монтирования."

#: src/ui/disk_editor.cpp
msgid "Create the recommended layout here"
msgstr "Создать здесь рекомендуемую разметку"

#: src/ui/disk_editor.cpp
msgid "or add a mount point yourself:"
msgstr "или добавьте точку монтирования самостоятельно:"

#: src/ui/disk_editor.cpp
msgid "Mount point"
msgstr "Точка монтирования"

#: src/ui/disk_editor.cpp
msgid "Size"
msgstr "Размер"

#: src/ui/disk_editor.cpp
msgid "File system"
msgstr "Файловая система"

#: src/ui/disk_editor.cpp
msgid "Device type"
msgstr "Тип устройства"

#: src/ui/disk_editor.cpp
msgid "LVM"
msgstr "LVM"

#: src/ui/disk_editor.cpp
msgid "LVM thin provisioning"
msgstr "Тонкое выделение LVM"

#: src/ui/disk_editor.cpp
msgid "Btrfs"
msgstr "Btrfs"

#: src/ui/disk_editor.cpp
msgid "Standard partition"
msgstr "Обычный раздел"

#: src/ui/disk_editor.cpp
msgid "Encrypt"
msgstr "Шифровать"

#: src/ui/disk_editor.cpp
msgid "Add mount point"
msgstr "Добавить точку монтирования"

#: src/ui/disk_editor.cpp src/ui/pages/review_page.cpp
msgid "Device"
msgstr "Устройство"

#: src/ui/disk_editor.cpp
msgid "Format"
msgstr "Формат"

#: src/ui/disk_editor.cpp
msgid "Label"
msgstr "Метка"

#: src/ui/disk_editor.cpp src/ui/pages/destination_page.cpp
msgid "none"
msgstr "нет"

#: src/ui/disk_editor.cpp
msgid "State"
msgstr "Состояние"

#: src/ui/disk_editor.cpp
msgid "on the disk now"
msgstr "сейчас на диске"

#: src/ui/disk_editor.cpp
msgid "to be created"
msgstr "будет создан"

#: src/ui/disk_editor.cpp
msgid "Use…"
msgstr "Использовать…"

#: src/ui/disk_editor.cpp
msgid "Change…"
msgstr "Изменить…"

#: src/ui/disk_editor.cpp
msgid "Resize…"
msgstr "Изменить размер…"

#: src/ui/disk_editor.cpp
msgid "Delete"
msgstr "Удалить"

#: src/ui/disk_editor.cpp
msgid "It cannot be shrunk now. Windows has to be shut down fully first: in Windows turn off Fast Startup, free some space, then shut it down (not restart)."
msgstr "Сейчас его нельзя уменьшить. Сначала полностью выключите Windows: в Windows отключите быстрый запуск, освободите немного места, затем выключите компьютер (не перезагрузка)."

#: src/ui/disk_editor.cpp
msgid "It holds LVM or Btrfs volumes. Delete it to use its space."
msgstr "Он содержит тома LVM или Btrfs. Удалите его, чтобы использовать его пространство."

#: src/ui/disk_editor.cpp
msgid "Volumes in it:"
msgstr "Тома в нём:"

#: src/ui/disk_editor.cpp
msgid "USE THIS PARTITION"
msgstr "ИСПОЛЬЗОВАТЬ ЭТОТ РАЗДЕЛ"

#: src/ui/disk_editor.cpp
msgid "CHANGE THIS MOUNT POINT"
msgstr "ИЗМЕНИТЬ ЭТУ ТОЧКУ МОНТИРОВАНИЯ"

#: src/ui/disk_editor.cpp
msgid "Format it (erases what is on it)"
msgstr "Отформатировать (всё содержимое будет стёрто)"

#: src/ui/disk_editor.cpp src/ui/pages/install_page.cpp
#: src/ui/pages/network_page.cpp
msgid "Cancel"
msgstr "Отмена"

#: src/ui/disk_editor.cpp
msgid "Apply"
msgstr "Применить"

#: src/ui/disk_editor.cpp
msgid "RESIZE"
msgstr "ИЗМЕНЕНИЕ РАЗМЕРА"

#: src/ui/disk_editor.cpp
msgid "Shrinking keeps the data on it and frees the rest of the space for the new system."
msgstr "При уменьшении данные на нём сохраняются, а остальное пространство освобождается для новой системы."

#: src/ui/disk_editor.cpp
msgid "The size the new partition will have."
msgstr "Размер, который будет у нового раздела."

#: src/ui/disk_editor.cpp
msgid "Resize"
msgstr "Изменить размер"

#: src/ui/disk_editor.cpp
#, python-brace-format
msgid "Delete {name}?"
msgstr "Удалить {name}?"

#: src/ui/disk_editor.cpp
msgid "Everything on it is lost when the installation starts. Until then, Reset all brings it back."
msgstr "Всё, что на нём находится, будет потеряно при начале установки. До этого момента кнопка «Сбросить всё» вернёт его."

#: src/ui/disk_editor.cpp
msgid "The planned partition is removed from the layout."
msgstr "Запланированный раздел будет удалён из разметки."

#: src/ui/disk_editor.cpp
msgid "That change could not be made"
msgstr "Не удалось внести это изменение"

#: src/ui/disk_editor.cpp
msgid "No mount points yet. Pick free space above and add “/”, or create the recommended layout."
msgstr "Точек монтирования пока нет. Выберите свободное место выше и добавьте «/» либо создайте рекомендуемую разметку."

#: src/ui/disk_editor.cpp
msgid "Nothing changes on the disks yet."
msgstr "На дисках пока ничего не меняется."

#: src/ui/disk_editor.cpp src/ui/pages/review_page.cpp
msgid "Check before installing"
msgstr "Проверка перед установкой"

#: src/ui/disk_editor.cpp
msgid "This layout cannot be installed"
msgstr "Эту разметку нельзя установить"

#: src/ui/installer.cpp
msgid "Guided installation"
msgstr "Пошаговая установка"

#: src/ui/installer.cpp
msgid "SETUP"
msgstr "НАСТРОЙКА"

#: src/ui/installer.cpp
msgid "All steps complete"
msgstr "Все шаги выполнены"

#: src/ui/installer.cpp
#, python-brace-format
msgid "Step {n} of {count}"
msgstr "Шаг {n} из {count}"

#: src/ui/installer.cpp
msgid "F1 Help   ·   F12 Console"
msgstr "F1 Справка   ·   F12 Консоль"

#: src/ui/installer.cpp
msgid "Back"
msgstr "Назад"

#: src/ui/installer.cpp
msgid "Continue"
msgstr "Продолжить"

#: src/ui/installer.cpp
msgid "Preparing the installer"
msgstr "Подготовка установщика"

#: src/ui/installer.cpp src/ui/pages/install_page.cpp
msgid "Quit"
msgstr "Выйти"

#: src/ui/installer.cpp
msgid "The installer cannot start"
msgstr "Установщик не может запуститься"

#: src/ui/installer.cpp
msgid "Help"
msgstr "Справка"

#: src/ui/installer.cpp
msgid "Installation log"
msgstr "Журнал установки"

#: src/ui/installer.cpp
msgid "Open a terminal"
msgstr "Открыть терминал"

#: src/ui/installer.cpp
msgid "Quit the installer"
msgstr "Выйти из установщика"

#: src/ui/installer.cpp
#, python-brace-format
msgid "STEP {n} — {name}"
msgstr "ШАГ {n} — {name}"

#: src/ui/installer.cpp
msgid "Quit the installer?"
msgstr "Выйти из установщика?"

#: src/ui/installer.cpp
msgid "Nothing has been written to your disks yet."
msgstr "На ваши диски пока ничего не записано."

#: src/ui/installer.cpp
msgid "The installation is running; stopping it now leaves the disk unusable until you install again."
msgstr "Идёт установка; если остановить её сейчас, диск останется непригодным для использования, пока вы не выполните установку заново."

#: src/ui/pages/account_page.cpp
msgid "Choose a user name."
msgstr "Выберите имя пользователя."

#: src/ui/pages/account_page.cpp
msgid "At most 32 characters."
msgstr "Не более 32 символов."

#: src/ui/pages/account_page.cpp
msgid "Start with a lower-case letter."
msgstr "Начните со строчной буквы."

#: src/ui/pages/account_page.cpp
msgid "Use lower-case letters, digits, “-” and “_” only."
msgstr "Используйте только строчные буквы, цифры, «-» и «_»."

#: src/ui/pages/account_page.cpp
msgid "That name belongs to the system."
msgstr "Это имя принадлежит системе."

#: src/ui/pages/account_page.cpp
msgid "Profile picture"
msgstr "Изображение профиля"

#: src/ui/pages/account_page.cpp
msgid "Generated from your initials · click to change"
msgstr "Создано из ваших инициалов · щёлкните, чтобы изменить"

#: src/ui/pages/account_page.cpp
msgid "Full name"
msgstr "Полное имя"

#: src/ui/pages/account_page.cpp
msgid "User name"
msgstr "Имя пользователя"

#: src/ui/pages/account_page.cpp src/ui/pages/network_page.cpp
msgid "Password"
msgstr "Пароль"

#: src/ui/pages/account_page.cpp
msgid "Confirm password"
msgstr "Подтверждение пароля"

#: src/ui/pages/account_page.cpp
msgid "Four random words beat one short complex password"
msgstr "Четыре случайных слова надёжнее одного короткого сложного пароля"

#: src/ui/pages/account_page.cpp
msgid "PERMISSIONS"
msgstr "РАЗРЕШЕНИЯ"

#: src/ui/pages/account_page.cpp
msgid "Make this user an administrator"
msgstr "Сделать этого пользователя администратором"

#: src/ui/pages/account_page.cpp
msgid "Require a password to sign in"
msgstr "Требовать пароль для входа"

#: src/ui/pages/account_page.cpp
msgid "Disable only on a physically secure machine"
msgstr "Отключайте только на физически защищённом компьютере"

#: src/ui/pages/account_page.cpp
msgid "ROOT ACCOUNT"
msgstr "УЧЁТНАЯ ЗАПИСЬ ROOT"

#: src/ui/pages/account_page.cpp
msgid "Lock the root account"
msgstr "Заблокировать учётную запись root"

#: src/ui/pages/account_page.cpp
msgid "Administer with sudo instead — safer by default"
msgstr "Вместо этого администрируйте через sudo — это безопаснее по умолчанию"

#: src/ui/pages/account_page.cpp src/ui/pages/destination_page.cpp
msgid "recommended"
msgstr "рекомендуется"

#: src/ui/pages/account_page.cpp
msgid "Set a root password"
msgstr "Задать пароль root"

#: src/ui/pages/account_page.cpp
msgid "Enables direct root sign-in on console and SSH"
msgstr "Включает прямой вход под root в консоли и по SSH"

#: src/ui/pages/account_page.cpp
msgid "Root password"
msgstr "Пароль root"

#: src/ui/pages/account_page.cpp
msgid "Confirm root password"
msgstr "Подтверждение пароля root"

#: src/ui/pages/account_page.cpp src/ui/pages/review_page.cpp
msgid "Account"
msgstr "Учётная запись"

#: src/ui/pages/account_page.cpp
msgid "Create your account."
msgstr "Создайте свою учётную запись."

#: src/ui/pages/account_page.cpp
msgid "This is the account you will sign in with on first boot. Pick a strong passphrase — it also unlocks your encrypted disk."
msgstr "С этой учётной записью вы будете входить при первой загрузке. Выберите надёжную парольную фразу — она также разблокирует ваш зашифрованный диск."

#: src/ui/pages/account_page.cpp
msgid "This is the account you will sign in with on first boot. Pick a strong passphrase you will remember."
msgstr "С этой учётной записью вы будете входить при первой загрузке. Выберите надёжную парольную фразу, которую вы запомните."

#: src/ui/pages/account_page.cpp
msgid "Enter your full name."
msgstr "Введите своё полное имя."

#: src/ui/pages/account_page.cpp
msgid "Choose a password."
msgstr "Выберите пароль."

#: src/ui/pages/account_page.cpp
msgid "The passwords do not match."
msgstr "Пароли не совпадают."

#: src/ui/pages/account_page.cpp
msgid "A disk passphrase needs at least 8 characters."
msgstr "Парольная фраза диска должна содержать не менее 8 символов."

#: src/ui/pages/account_page.cpp
msgid "Choose a root password."
msgstr "Выберите пароль root."

#: src/ui/pages/account_page.cpp
msgid "The root passwords do not match."
msgstr "Пароли root не совпадают."

#: src/ui/pages/account_page.cpp
msgid "With root locked, this user must be an administrator."
msgstr "Если root заблокирован, этот пользователь должен быть администратором."

#: src/ui/pages/account_page.cpp
msgid "this user"
msgstr "этого пользователя"

#: src/ui/pages/account_page.cpp
#, python-brace-format
msgid "Adds {user} to the wheel group and allows sudo"
msgstr "Добавляет {user} в группу wheel и разрешает sudo"

#: src/ui/pages/account_page.cpp
msgid "Weak passphrase"
msgstr "Слабая парольная фраза"

#: src/ui/pages/account_page.cpp
msgid "Fair passphrase"
msgstr "Средняя парольная фраза"

#: src/ui/pages/account_page.cpp
msgid "Good passphrase"
msgstr "Хорошая парольная фраза"

#: src/ui/pages/account_page.cpp
msgid "Strong passphrase"
msgstr "Сильная парольная фраза"

#: src/ui/pages/account_page.cpp
#, python-brace-format
msgid "{n} character"
msgid_plural "{n} characters"
msgstr[0] "{n} символ"
msgstr[1] "{n} символа"
msgstr[2] "{n} символов"

#: src/ui/pages/account_page.cpp
msgid "Your passphrase unlocks LUKS2 at every boot. It is never written to the kickstart file or to installation logs."
msgstr "Ваша парольная фраза разблокирует LUKS2 при каждой загрузке. Она никогда не записывается в файл kickstart или в журналы установки."

#: src/ui/pages/account_page.cpp
msgid "The password is stored only as a hash on the new system and never written to the installation logs."
msgstr "Пароль хранится в новой системе только в виде хеша и никогда не записывается в журналы установки."

#: src/ui/pages/account_page.cpp
msgid "Choose a profile picture"
msgstr "Выберите изображение профиля"

#: src/ui/pages/account_page.cpp
msgid "Images (*.png *.jpg *.jpeg *.webp *.svg)"
msgstr "Изображения (*.png *.jpg *.jpeg *.webp *.svg)"

#: src/ui/pages/account_page.cpp
msgid "Click to choose another"
msgstr "Щёлкните, чтобы выбрать другое"

#: src/ui/pages/destination_page.cpp
msgid "installation media"
msgstr "установочный носитель"

#: src/ui/pages/destination_page.cpp
#, python-brace-format
msgid "{system} detected"
msgstr "Обнаружена система {system}"

#: src/ui/pages/destination_page.cpp
msgid "empty"
msgstr "пусто"

#: src/ui/pages/destination_page.cpp
#, python-brace-format
msgid "{n} partition"
msgid_plural "{n} partitions"
msgstr[0] "{n} раздел"
msgstr[1] "{n} раздела"
msgstr[2] "{n} разделов"

#: src/ui/pages/destination_page.cpp
msgid "Windows has to be shut down fully first: in Windows turn off Fast Startup, free some space, then shut it down (not restart) and start the installer again."
msgstr "Сначала полностью выключите Windows: в Windows отключите быстрый запуск, освободите немного места, затем выключите компьютер (не перезагрузка) и снова запустите установщик."

#: src/ui/pages/destination_page.cpp
msgid "the data on it"
msgstr "данные на нём"

#: src/ui/pages/destination_page.cpp
#, python-brace-format
