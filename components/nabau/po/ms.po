msgstr "Frasa laluan anda membuka kunci LUKS2 pada setiap but. Ia tidak pernah ditulis ke fail kickstart atau log pemasangan."

#: src/ui/pages/account_page.cpp
msgid "The password is stored only as a hash on the new system and never written to the installation logs."
msgstr "Kata laluan disimpan hanya sebagai cincangan pada sistem baharu dan tidak pernah ditulis ke log pemasangan."

#: src/ui/pages/account_page.cpp
msgid "Choose a profile picture"
msgstr "Pilih gambar profil"

#: src/ui/pages/account_page.cpp
msgid "Images (*.png *.jpg *.jpeg *.webp *.svg)"
msgstr "Imej (*.png *.jpg *.jpeg *.webp *.svg)"

#: src/ui/pages/account_page.cpp
msgid "Click to choose another"
msgstr "Klik untuk memilih yang lain"

