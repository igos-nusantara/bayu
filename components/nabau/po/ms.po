msgstr "Menyiapkan sistem yang dipasang"

#: src/anaconda_backend.cpp
msgid "Finishing the system did not complete; see /tmp/nabau-post.log"
msgstr "Penyiapan sistem tidak selesai; lihat /tmp/nabau-post.log"

#: src/anaconda_backend.cpp
msgid "Complete"
msgstr "Selesai"

