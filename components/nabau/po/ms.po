#: src/ui/pages/account_page.cpp
msgid "Create your account."
msgstr "Cipta akaun anda."

#: src/ui/pages/account_page.cpp
msgid "This is the account you will sign in with on first boot. Pick a strong passphrase — it also unlocks your encrypted disk."
msgstr "Ini ialah akaun yang akan anda gunakan untuk log masuk pada but pertama. Pilih frasa laluan yang kukuh — ia juga membuka kunci cakera tersulit anda."

#: src/ui/pages/account_page.cpp
msgid "This is the account you will sign in with on first boot. Pick a strong passphrase you will remember."
msgstr "Ini ialah akaun yang akan anda gunakan untuk log masuk pada but pertama. Pilih frasa laluan kukuh yang anda akan ingat."

#: src/ui/pages/account_page.cpp
msgid "Enter your full name."
msgstr "Masukkan nama penuh anda."

#: src/ui/pages/account_page.cpp
msgid "Choose a password."
msgstr "Pilih kata laluan."

#: src/ui/pages/account_page.cpp
msgid "The passwords do not match."
msgstr "Kata laluan tidak sepadan."

#: src/ui/pages/account_page.cpp
msgid "A disk passphrase needs at least 8 characters."
msgstr "Frasa laluan cakera memerlukan sekurang-kurangnya 8 aksara."

#: src/ui/pages/account_page.cpp
msgid "Choose a root password."
msgstr "Pilih kata laluan root."

#: src/ui/pages/account_page.cpp
msgid "The root passwords do not match."
msgstr "Kata laluan root tidak sepadan."

#: src/ui/pages/account_page.cpp
msgid "With root locked, this user must be an administrator."
msgstr "Dengan root dikunci, pengguna ini mesti menjadi pentadbir."

