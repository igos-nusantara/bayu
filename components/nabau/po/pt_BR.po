msgstr "Lendo os discos"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "The EFI partition {device} has {free} MB free; the boot loader needs {needed} MB."
msgstr "A partição EFI {device} tem {free} MB livres; o carregador de inicialização precisa de {needed} MB."

#: src/anaconda_backend.cpp
msgid "Lay out the disk first."
msgstr "Defina primeiro o layout do disco."

#: src/anaconda_backend.cpp
msgid "Finishing the installed system"
msgstr "Concluindo o sistema instalado"

#: src/anaconda_backend.cpp
msgid "Finishing the system did not complete; see /tmp/nabau-post.log"
msgstr "A conclusão do sistema não foi finalizada; veja /tmp/nabau-post.log"

#: src/anaconda_backend.cpp
msgid "Complete"
msgstr "Concluído"

