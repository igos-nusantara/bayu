#: src/ui/pages/account_page.cpp
msgid "Create your account."
msgstr "Crie sua conta."

#: src/ui/pages/account_page.cpp
msgid "This is the account you will sign in with on first boot. Pick a strong passphrase — it also unlocks your encrypted disk."
msgstr "Esta é a conta com a qual você entrará no primeiro boot. Escolha uma senha forte — ela também desbloqueia seu disco criptografado."

#: src/ui/pages/account_page.cpp
msgid "This is the account you will sign in with on first boot. Pick a strong passphrase you will remember."
msgstr "Esta é a conta com a qual você entrará no primeiro boot. Escolha uma senha forte que você consiga lembrar."

#: src/ui/pages/account_page.cpp
msgid "Enter your full name."
msgstr "Digite seu nome completo."

#: src/ui/pages/account_page.cpp
msgid "Choose a password."
msgstr "Escolha uma senha."

#: src/ui/pages/account_page.cpp
msgid "The passwords do not match."
msgstr "As senhas não coincidem."

#: src/ui/pages/account_page.cpp
msgid "A disk passphrase needs at least 8 characters."
msgstr "A senha do disco precisa ter pelo menos 8 caracteres."

#: src/ui/pages/account_page.cpp
msgid "Choose a root password."
msgstr "Escolha uma senha de root."

#: src/ui/pages/account_page.cpp
msgid "The root passwords do not match."
msgstr "As senhas de root não coincidem."

#: src/ui/pages/account_page.cpp
msgid "With root locked, this user must be an administrator."
msgstr "Com o root bloqueado, este usuário deve ser administrador."

#: src/ui/pages/account_page.cpp
msgid "this user"
msgstr "este usuário"

#: src/ui/pages/account_page.cpp
#, python-brace-format
msgid "Adds {user} to the wheel group and allows sudo"
msgstr "Adiciona {user} ao grupo wheel e permite sudo"

#: src/ui/pages/account_page.cpp
msgid "Weak passphrase"
msgstr "Frase-senha fraca"

#: src/ui/pages/account_page.cpp
msgid "Fair passphrase"
msgstr "Frase-senha razoável"

#: src/ui/pages/account_page.cpp
msgid "Good passphrase"
msgstr "Frase-senha boa"

#: src/ui/pages/account_page.cpp
msgid "Strong passphrase"
msgstr "Frase-senha forte"

#: src/ui/pages/account_page.cpp
#, python-brace-format
msgid "{n} character"
msgid_plural "{n} characters"
msgstr[0] "{n} caractere"
msgstr[1] "{n} caracteres"

