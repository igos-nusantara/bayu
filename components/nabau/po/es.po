#: src/anaconda_backend.cpp
msgid "Starting the installation backend"
msgstr "Iniciando el motor de instalación"

#: src/anaconda_backend.cpp
msgid "The installer needs administrator rights, which were not given."
msgstr "El instalador necesita derechos de administrador, que no se concedieron."

#: src/anaconda_backend.cpp
msgid "The installation backend stopped unexpectedly. Its log is in /tmp/anaconda.log."
msgstr "El motor de instalación se detuvo inesperadamente. Su registro está en /tmp/anaconda.log."

#: src/anaconda_backend.cpp
msgid "Cannot start the installation backend (pkexec is missing)."
msgstr "No se puede iniciar el motor de instalación (falta pkexec)."

#: src/anaconda_backend.cpp
msgid "This partition holds LVM or Btrfs volumes. Delete it to use its space."
msgstr "Esta partición contiene volúmenes LVM o Btrfs. Elimínala para usar su espacio."

#: src/anaconda_backend.cpp
msgid "This partition cannot be resized."
msgstr "No se puede cambiar el tamaño de esta partición."

#: src/anaconda_backend.cpp
msgid "Choose a disk first."
msgstr "Elige primero un disco."

#: src/anaconda_backend.cpp
msgid "This disk already has a root (/) mount point."
msgstr "Este disco ya tiene un punto de montaje raíz (/)."

#: src/anaconda_backend.cpp
msgid "There is not enough free space left for the system."
msgstr "No queda espacio libre suficiente para el sistema."

#: src/anaconda_backend.cpp
msgid "This live system"
msgstr "Este sistema en vivo"

#: src/anaconda_backend.cpp
msgid "The desktop on this media, as you see it now: Files, Terminal, Settings"
msgstr "El escritorio de este medio, tal como lo ves ahora: Archivos, Terminal, Ajustes"

#: src/anaconda_backend.cpp
msgid "Development Tools"
msgstr "Herramientas de desarrollo"

#: src/anaconda_backend.cpp
