msgstr "Herramientas de contenedores"

#: src/anaconda_backend.cpp
msgid "podman, buildah, skopeo"
msgstr "podman, buildah, skopeo"

#: src/anaconda_backend.cpp
msgid "RPM Development"
msgstr "Desarrollo de RPM"

#: src/anaconda_backend.cpp
msgid "rpmbuild, mock"
msgstr "rpmbuild, mock"

#: src/anaconda_backend.cpp
msgid "Headless Management"
msgstr "Gestión sin interfaz gráfica"

#: src/anaconda_backend.cpp
msgid "cockpit, remote administration"
msgstr "cockpit, administración remota"

#: src/anaconda_backend.cpp
msgid "Scientific Support"
msgstr "Soporte científico"

#: src/anaconda_backend.cpp
msgid "Math and science libraries"
msgstr "Bibliotecas de matemáticas y ciencias"

#: src/anaconda_backend.cpp
msgid "Checking the installation medium"
msgstr "Comprobando el medio de instalación"

#: src/anaconda_backend.cpp
msgid "The installation medium is damaged: part of it cannot be read as it was made. Nothing on the disks has changed. Copy the image to the USB drive again, check its SHA-256, or use another USB drive."
msgstr "El medio de instalación está dañado: una parte no se puede leer tal como se creó. No se ha cambiado nada en los discos. Copie de nuevo la imagen a la unidad USB, compruebe su SHA-256 o use otra unidad USB."

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "==> {path} <=="
msgstr "==> {path} <=="

#: src/anaconda_backend.cpp
msgid "(cannot be read)"
msgstr "(no se puede leer)"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "Checking the installation medium · {percent}%"
msgstr "Comprobando el medio de instalación · {percent}%"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "Cannot connect to the installation backend at {address}."
msgstr "No se puede conectar con el motor de instalación en {address}."

#: src/anaconda_backend.cpp
msgid "Reading the disks"
msgstr "Leyendo los discos"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "The EFI partition {device} has {free} MB free; the boot loader needs {needed} MB."
msgstr "La partición EFI {device} tiene {free} MB libres; el gestor de arranque necesita {needed} MB."

#: src/anaconda_backend.cpp
msgid "Lay out the disk first."
msgstr "Distribuye primero el disco."

#: src/anaconda_backend.cpp
msgid "Finishing the installed system"
msgstr "Finalizando el sistema instalado"

#: src/anaconda_backend.cpp
msgid "Finishing the system did not complete; see /tmp/nabau-post.log"
msgstr "No se completó la finalización del sistema; consulta /tmp/nabau-post.log"

#: src/anaconda_backend.cpp
msgid "Complete"
msgstr "Completado"

