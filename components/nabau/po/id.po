msgid "Lay out the disk first."
msgstr "Atur tata letak disk terlebih dahulu."

#: src/anaconda_backend.cpp
msgid "Finishing the installed system"
msgstr "Menyelesaikan sistem yang terpasang"

#: src/anaconda_backend.cpp
msgid "Finishing the system did not complete; see /tmp/nabau-post.log"
msgstr "Penyelesaian sistem tidak tuntas; lihat /tmp/nabau-post.log"

#: src/anaconda_backend.cpp
msgid "Complete"
msgstr "Selesai"

