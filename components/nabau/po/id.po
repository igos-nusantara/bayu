msgstr "Ini adalah akun yang akan Anda gunakan untuk masuk saat boot pertama. Pilih frasa sandi kuat yang Anda ingat."

#: src/ui/pages/account_page.cpp
msgid "Enter your full name."
msgstr "Masukkan nama lengkap Anda."

#: src/ui/pages/account_page.cpp
msgid "Choose a password."
msgstr "Pilih kata sandi."

#: src/ui/pages/account_page.cpp
msgid "The passwords do not match."
msgstr "Kata sandi tidak cocok."

#: src/ui/pages/account_page.cpp
msgid "A disk passphrase needs at least 8 characters."
msgstr "Frasa sandi disk memerlukan minimal 8 karakter."

#: src/ui/pages/account_page.cpp
msgid "Choose a root password."
msgstr "Pilih kata sandi root."

#: src/ui/pages/account_page.cpp
msgid "The root passwords do not match."
msgstr "Kata sandi root tidak cocok."

#: src/ui/pages/account_page.cpp
msgid "With root locked, this user must be an administrator."
msgstr "Dengan root terkunci, pengguna ini harus menjadi administrator."

#: src/ui/pages/account_page.cpp
msgid "this user"
msgstr "pengguna ini"

#: src/ui/pages/account_page.cpp
#, python-brace-format
msgid "Adds {user} to the wheel group and allows sudo"
msgstr "Menambahkan {user} ke grup wheel dan mengizinkan sudo"

#: src/ui/pages/account_page.cpp
msgid "Weak passphrase"
msgstr "Frasa sandi lemah"

#: src/ui/pages/account_page.cpp
msgid "Fair passphrase"
msgstr "Frasa sandi cukup"

#: src/ui/pages/account_page.cpp
msgid "Good passphrase"
msgstr "Frasa sandi baik"

#: src/ui/pages/account_page.cpp
msgid "Strong passphrase"
msgstr "Frasa sandi kuat"

#: src/ui/pages/account_page.cpp
#, python-brace-format
msgid "{n} character"
msgid_plural "{n} characters"
msgstr[0] "{n} karakter"

#: src/ui/pages/account_page.cpp
msgid "Your passphrase unlocks LUKS2 at every boot. It is never written to the kickstart file or to installation logs."
msgstr "Frasa sandi Anda membuka kunci LUKS2 pada setiap boot. Frasa ini tidak pernah ditulis ke berkas kickstart atau log instalasi."

#: src/ui/pages/account_page.cpp
msgid "The password is stored only as a hash on the new system and never written to the installation logs."
msgstr "Kata sandi disimpan hanya sebagai hash di sistem baru dan tidak pernah ditulis ke log instalasi."

#: src/ui/pages/account_page.cpp
msgid "Choose a profile picture"
msgstr "Pilih foto profil"

#: src/ui/pages/account_page.cpp
msgid "Images (*.png *.jpg *.jpeg *.webp *.svg)"
msgstr "Gambar (*.png *.jpg *.jpeg *.webp *.svg)"

#: src/ui/pages/account_page.cpp
msgid "Click to choose another"
msgstr "Klik untuk memilih yang lain"

#: src/ui/pages/destination_page.cpp
msgid "installation media"
msgstr "media instalasi"

