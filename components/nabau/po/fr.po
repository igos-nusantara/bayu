#: src/anaconda_backend.cpp
msgid "Starting the installation backend"
msgstr "Démarrage du moteur d’installation"

#: src/anaconda_backend.cpp
msgid "The installer needs administrator rights, which were not given."
msgstr "L’installateur nécessite des droits d’administrateur, qui n’ont pas été accordés."

#: src/anaconda_backend.cpp
msgid "The installation backend stopped unexpectedly. Its log is in /tmp/anaconda.log."
msgstr "Le moteur d’installation s’est arrêté de manière inattendue. Son journal se trouve dans /tmp/anaconda.log."

