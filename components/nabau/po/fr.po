msgstr "La partition EFI {device} a {free} Mo libres ; le chargeur d’amorçage a besoin de {needed} Mo."

#: src/anaconda_backend.cpp
msgid "Lay out the disk first."
msgstr "Organisez d’abord le disque."

#: src/anaconda_backend.cpp
msgid "Finishing the installed system"
msgstr "Finalisation du système installé"

#: src/anaconda_backend.cpp
msgid "Finishing the system did not complete; see /tmp/nabau-post.log"
msgstr "La finalisation du système n’a pas abouti ; consultez /tmp/nabau-post.log"

#: src/anaconda_backend.cpp
msgid "Complete"
msgstr "Terminé"

