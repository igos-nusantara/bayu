msgid "Require a password to sign in"
msgstr "Exiger un mot de passe pour se connecter"

#: src/ui/pages/account_page.cpp
msgid "Disable only on a physically secure machine"
msgstr "À désactiver uniquement sur une machine physiquement sécurisée"

