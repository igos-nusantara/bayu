#, python-brace-format
msgid "Checking the installation medium · {percent}%"
msgstr "Vérification du support d’installation · {percent}%"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "Cannot connect to the installation backend at {address}."
msgstr "Impossible de se connecter au moteur d’installation à l’adresse {address}."

#: src/anaconda_backend.cpp
msgid "Reading the disks"
msgstr "Lecture des disques"

#: src/anaconda_backend.cpp
#, python-brace-format
