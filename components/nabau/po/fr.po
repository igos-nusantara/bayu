msgstr "Windows doit d’abord être complètement arrêté : dans Windows, désactivez le démarrage rapide, libérez de l’espace, puis arrêtez-le (sans redémarrer) et relancez l’installateur."

#: src/ui/pages/destination_page.cpp
msgid "the data on it"
msgstr "les données qu’il contient"

#: src/ui/pages/destination_page.cpp
#, python-brace-format
msgid "{disk} already holds data"
msgstr "{disk} contient déjà des données"

