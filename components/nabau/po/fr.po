msgid "Math and science libraries"
msgstr "Bibliothèques de mathématiques et de sciences"

#: src/anaconda_backend.cpp
msgid "Checking the installation medium"
msgstr "Vérification du support d’installation"

#: src/anaconda_backend.cpp
msgid "The installation medium is damaged: part of it cannot be read as it was made. Nothing on the disks has changed. Copy the image to the USB drive again, check its SHA-256, or use another USB drive."
msgstr "Le support d’installation est endommagé : une partie ne peut pas être lue telle qu’elle a été créée. Rien n’a été modifié sur les disques. Copiez à nouveau l’image sur la clé USB, vérifiez son SHA-256 ou utilisez une autre clé USB."

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "==> {path} <=="
msgstr "==> {path} <=="

#: src/anaconda_backend.cpp
msgid "(cannot be read)"
msgstr "(illisible)"

