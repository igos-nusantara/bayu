msgid "Root password"
msgstr "Mot de passe root"

#: src/ui/pages/account_page.cpp
msgid "Confirm root password"
msgstr "Confirmer le mot de passe root"

#: src/ui/pages/account_page.cpp src/ui/pages/review_page.cpp
msgid "Account"
msgstr "Compte"

#: src/ui/pages/account_page.cpp
msgid "Create your account."
msgstr "Créez votre compte."

#: src/ui/pages/account_page.cpp
msgid "This is the account you will sign in with on first boot. Pick a strong passphrase — it also unlocks your encrypted disk."
msgstr "C’est le compte avec lequel vous vous connecterez au premier démarrage. Choisissez une phrase secrète robuste : elle déverrouille aussi votre disque chiffré."

#: src/ui/pages/account_page.cpp
msgid "This is the account you will sign in with on first boot. Pick a strong passphrase you will remember."
msgstr "C’est le compte avec lequel vous vous connecterez au premier démarrage. Choisissez une phrase secrète robuste dont vous vous souviendrez."

#: src/ui/pages/account_page.cpp
msgid "Enter your full name."
msgstr "Saisissez votre nom complet."

#: src/ui/pages/account_page.cpp
msgid "Choose a password."
msgstr "Choisissez un mot de passe."

#: src/ui/pages/account_page.cpp
msgid "The passwords do not match."
msgstr "Les mots de passe ne correspondent pas."

#: src/ui/pages/account_page.cpp
msgid "A disk passphrase needs at least 8 characters."
msgstr "Une phrase secrète de disque doit comporter au moins 8 caractères."

#: src/ui/pages/account_page.cpp
msgid "Choose a root password."
msgstr "Choisissez un mot de passe root."

#: src/ui/pages/account_page.cpp
msgid "The root passwords do not match."
msgstr "Les mots de passe root ne correspondent pas."

#: src/ui/pages/account_page.cpp
msgid "With root locked, this user must be an administrator."
msgstr "Le compte root étant verrouillé, cet utilisateur doit être administrateur."

#: src/ui/pages/account_page.cpp
msgid "this user"
msgstr "cet utilisateur"

#: src/ui/pages/account_page.cpp
#, python-brace-format
msgid "Adds {user} to the wheel group and allows sudo"
msgstr "Ajoute {user} au groupe wheel et autorise sudo"

#: src/ui/pages/account_page.cpp
msgid "Weak passphrase"
msgstr "Phrase de passe faible"

#: src/ui/pages/account_page.cpp
msgid "Fair passphrase"
msgstr "Phrase de passe correcte"

#: src/ui/pages/account_page.cpp
msgid "Good passphrase"
msgstr "Bonne phrase de passe"

#: src/ui/pages/account_page.cpp
msgid "Strong passphrase"
msgstr "Phrase de passe forte"

#: src/ui/pages/account_page.cpp
#, python-brace-format
msgid "{n} character"
msgid_plural "{n} characters"
msgstr[0] "{n} caractère"
msgstr[1] "{n} caractères"

#: src/ui/pages/account_page.cpp
msgid "Your passphrase unlocks LUKS2 at every boot. It is never written to the kickstart file or to installation logs."
msgstr "Votre phrase secrète déverrouille LUKS2 à chaque démarrage. Elle n’est jamais écrite dans le fichier kickstart ni dans les journaux d’installation."

#: src/ui/pages/account_page.cpp
msgid "The password is stored only as a hash on the new system and never written to the installation logs."
msgstr "Le mot de passe n’est stocké que sous forme de hachage sur le nouveau système et n’est jamais écrit dans les journaux d’installation."

#: src/ui/pages/account_page.cpp
msgid "Choose a profile picture"
msgstr "Choisir une photo de profil"

#: src/ui/pages/account_page.cpp
msgid "Images (*.png *.jpg *.jpeg *.webp *.svg)"
msgstr "Images (*.png *.jpg *.jpeg *.webp *.svg)"

#: src/ui/pages/account_page.cpp
msgid "Click to choose another"
msgstr "Cliquez pour en choisir une autre"

