#: src/anaconda_backend.cpp
msgid "Starting the installation backend"
msgstr "설치 백엔드를 시작하는 중"

#: src/anaconda_backend.cpp
msgid "The installer needs administrator rights, which were not given."
msgstr "설치 프로그램에 관리자 권한이 필요하지만 부여되지 않았습니다."

#: src/anaconda_backend.cpp
msgid "The installation backend stopped unexpectedly. Its log is in /tmp/anaconda.log."
msgstr "설치 백엔드가 예기치 않게 중지되었습니다. 로그는 /tmp/anaconda.log에 있습니다."

#: src/anaconda_backend.cpp
msgid "Cannot start the installation backend (pkexec is missing)."
msgstr "설치 백엔드를 시작할 수 없습니다(pkexec이 없음)."

#: src/anaconda_backend.cpp
msgid "This partition holds LVM or Btrfs volumes. Delete it to use its space."
msgstr "이 파티션에는 LVM 또는 Btrfs 볼륨이 있습니다. 공간을 사용하려면 삭제하세요."

#: src/anaconda_backend.cpp
msgid "This partition cannot be resized."
msgstr "이 파티션은 크기를 조정할 수 없습니다."

#: src/anaconda_backend.cpp
msgid "Choose a disk first."
msgstr "먼저 디스크를 선택하세요."

#: src/anaconda_backend.cpp
msgid "This disk already has a root (/) mount point."
msgstr "이 디스크에는 이미 루트(/) 마운트 지점이 있습니다."

#: src/anaconda_backend.cpp
msgid "There is not enough free space left for the system."
msgstr "시스템을 위한 여유 공간이 부족합니다."

#: src/anaconda_backend.cpp
msgid "This live system"
msgstr "이 라이브 시스템"

#: src/anaconda_backend.cpp
msgid "The desktop on this media, as you see it now: Files, Terminal, Settings"
msgstr "지금 보시는 이 미디어의 데스크톱: 파일, 터미널, 설정"

#: src/anaconda_backend.cpp
msgid "Development Tools"
msgstr "개발 도구"

#: src/anaconda_backend.cpp
msgid "gcc, make, git, headers"
msgstr "gcc, make, git, 헤더"

#: src/anaconda_backend.cpp
msgid "Container Tools"
msgstr "컨테이너 도구"

#: src/anaconda_backend.cpp
msgid "podman, buildah, skopeo"
msgstr "podman, buildah, skopeo"

#: src/anaconda_backend.cpp
msgid "RPM Development"
msgstr "RPM 개발"

#: src/anaconda_backend.cpp
msgid "rpmbuild, mock"
msgstr "rpmbuild, mock"

#: src/anaconda_backend.cpp
msgid "Headless Management"
msgstr "헤드리스 관리"

#: src/anaconda_backend.cpp
msgid "cockpit, remote administration"
msgstr "cockpit, 원격 관리"

#: src/anaconda_backend.cpp
msgid "Scientific Support"
msgstr "과학 지원"

#: src/anaconda_backend.cpp
msgid "Math and science libraries"
msgstr "수학 및 과학 라이브러리"

#: src/anaconda_backend.cpp
msgid "Checking the installation medium"
msgstr "설치 미디어 확인 중"

#: src/anaconda_backend.cpp
msgid "The installation medium is damaged: part of it cannot be read as it was made. Nothing on the disks has changed. Copy the image to the USB drive again, check its SHA-256, or use another USB drive."
msgstr "설치 미디어가 손상되었습니다. 일부를 만들 때와 같이 읽을 수 없습니다. 디스크는 아직 변경되지 않았습니다. 이미지를 USB 드라이브에 다시 복사하고 SHA-256을 확인하거나 다른 USB 드라이브를 사용하십시오."

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "==> {path} <=="
msgstr "==> {path} <=="

#: src/anaconda_backend.cpp
msgid "(cannot be read)"
msgstr "(읽을 수 없음)"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "Checking the installation medium · {percent}%"
msgstr "설치 미디어 확인 중 · {percent}%"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "Cannot connect to the installation backend at {address}."
msgstr "{address}의 설치 백엔드에 연결할 수 없습니다."

#: src/anaconda_backend.cpp
msgid "Reading the disks"
msgstr "디스크를 읽는 중"

#: src/anaconda_backend.cpp
#, python-brace-format
msgid "The EFI partition {device} has {free} MB free; the boot loader needs {needed} MB."
msgstr "EFI 파티션 {device}의 여유 공간은 {free} MB입니다. 부트 로더에는 {needed} MB가 필요합니다."

#: src/anaconda_backend.cpp
msgid "Lay out the disk first."
msgstr "먼저 디스크 레이아웃을 구성하세요."

#: src/anaconda_backend.cpp
msgid "Finishing the installed system"
msgstr "설치된 시스템 마무리 중"

#: src/anaconda_backend.cpp
msgid "Finishing the system did not complete; see /tmp/nabau-post.log"
msgstr "시스템 마무리가 완료되지 않았습니다. /tmp/nabau-post.log를 확인하세요"

#: src/anaconda_backend.cpp
msgid "Complete"
msgstr "완료"

#: src/network_manager.cpp
#, python-brace-format
msgid "Wired · {name}"
msgstr "유선 · {name}"

#: src/network_manager.cpp
#, python-brace-format
msgid "Connected · {rate}"
msgstr "연결됨 · {rate}"

#: src/network_manager.cpp
msgid "Connected"
msgstr "연결됨"

#: src/network_manager.cpp
msgid "Cable connected · not set up"
msgstr "케이블 연결됨 · 설정되지 않음"

#: src/network_manager.cpp
msgid "Cable unplugged"
msgstr "케이블 분리됨"

#: src/network_manager.cpp
#, python-brace-format
msgid "{security} · secured"
msgstr "{security} · 보안 연결"

#: src/network_manager.cpp
msgid "Open network"
msgstr "공개 네트워크"

#: src/network_manager.cpp
msgid "Personal hotspot"
msgstr "개인 핫스폿"

#: src/network_manager.cpp
msgid "NetworkManager is not running."
msgstr "NetworkManager가 실행 중이 아닙니다."

