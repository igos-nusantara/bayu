#: src/ui/disk_editor.cpp
msgid "PENDING CHANGES"
msgstr "보류 중인 변경 사항"

#: src/ui/disk_editor.cpp
msgid "Reset all"
msgstr "모두 초기화"

#: src/ui/disk_editor.cpp
#, python-brace-format
msgid "{size} free"
msgstr "{size} 사용 가능"

#: src/ui/disk_editor.cpp
msgid "Select a part of a disk above."
msgstr "위에서 디스크의 일부를 선택하세요."

#: src/ui/disk_editor.cpp
msgid "Too small to hold a mount point."
msgstr "마운트 지점을 담기에는 너무 작습니다."

#: src/ui/disk_editor.cpp
msgid "Create the recommended layout here"
msgstr "여기에 권장 레이아웃 만들기"

#: src/ui/disk_editor.cpp
msgid "or add a mount point yourself:"
msgstr "또는 마운트 지점을 직접 추가하세요:"

