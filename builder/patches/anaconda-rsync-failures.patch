+def full_mounts(sysroot):
+    """The file systems under the sysroot with next to no space left, as
+    "/boot/efi (0 MB free)". A full vfat says nothing in the kernel log, and
+    rsync's receiver can die before its "No space left" reaches the log."""
+    root = sysroot.rstrip("/")
+    full = []
+    try:
+        with open("/proc/self/mounts") as mounts:
+            # Disks only, not /sys or /dev bound in.
+            targets = [line.split()[1].replace("\\040", " ") for line in mounts if line.startswith("/dev/")]
+    except OSError:
+        return full
+    for target in targets:
+        if target != root and not target.startswith(root + "/"):
+            continue
+        try:
+            fs = os.statvfs(target)
+        except OSError:
+            continue
+        free = fs.f_bavail * fs.f_frsize
+        if fs.f_blocks and free < 4 * 1024 * 1024:
+            full.append("{} ({} MB free)".format(target[len(root):] or "/", free // (1024 * 1024)))
+    return full
+
+
+def rsync_failure(rc, errors, full=()):
+    """Why copying the system stopped, for the user: rsync's exit, its errors
+    and the file systems that are full."""
+    text = "\n".join(errors)
+    if rc < 0:
+        why = "rsync was stopped by signal {}".format(-rc)
+        if rc == -9:
+            why += ", probably for lack of memory"
+    else:
+        why = "rsync exited with code {}".format(rc)
+    if full:
+        hint = "There is no space left on {}.".format(", ".join(full))
+    elif "No space left on device" in text:
+        hint = "The target disk or partition is full."
+    elif "Input/output error" in text:
+        hint = "A disk could not be read or written: the installation medium (write the " \
+               "image again, or use another USB drive) or the target disk."
+    else:
+        hint = ""
+    return " ".join(part for part in (
+        "Copying the system to the disk failed ({}).".format(why), hint, text) if part)
+
+
